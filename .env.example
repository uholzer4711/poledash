# =============================================================================
# polestar-dash configuration
# Values with $ MUST be wrapped in single quotes (python-dotenv keeps literal).
# =============================================================================

# --- Polestar credentials (required) ----------------------------------------
POLESTAR_EMAIL=you@example.com
POLESTAR_PASSWORD='changeme'
# Optional: comma-separated VINs. Empty = auto-discover.
POLESTAR_VINS=

# --- Polling ----------------------------------------------------------------
# Slow cadence when idle; fast cadence while charging (so the curve is dense).
POLL_INTERVAL_MIN=10
FAST_POLL_INTERVAL_MIN=2

# Throttle polling when the car is at rest — spares the shared account + 12V
# battery. Never slows while charging or driving. Defaults shown; uncomment to
# tune, or set ADAPTIVE_IDLE_ENABLED=false to keep the flat cadence above.
# ADAPTIVE_IDLE_ENABLED=true
# NIGHT_HOUR_FROM=23
# NIGHT_HOUR_TO=5
# NIGHT_POLL_INTERVAL_MIN=30
# C3_NIGHT_POLL_INTERVAL_MIN=30
# IDLE_POLL_INTERVAL_MIN=20
# C3_IDLE_POLL_INTERVAL_MIN=15

# --- HTTP / paths -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATA_DIR=/data
TZ=Europe/Vienna
BACKUP_KEEP_DAYS=14
# Activity-log history (the /log tab): flush the in-memory ring to the DB every
# N minutes, and prune persisted log rows after this many days.
LOG_PERSIST_INTERVAL_MIN=2
LOG_RETENTION_DAYS=90

# --- Email notifications via SMTP (optional) --------------------------------
# Works with Gmail (use an App Password), Fastmail, or any SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- ntfy.sh push notifications (optional) ----------------------------------
# Leave NTFY_TOPIC empty to disable. Use an unguessable string — ntfy.sh is public.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_USERNAME=
NTFY_PASSWORD=

# --- Telegram (optional) ----------------------------------------------------
# Create a bot via @BotFather, copy the token; for chat_id message your bot
# and call https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notification thresholds ------------------------------------------------
NOTIFY_LOW_SOC=20
NOTIFY_SERVICE_DAYS=30
# Alert when the app logs an ERROR/CRITICAL (deduped to 1 per source per hour).
NOTIFY_LOG_ERRORS=false

# --- Automations (one-tap confirm links) ------------------------------------
# External, browser-reachable base URL of this app. Used to build the one-tap
# confirm links in automation "suggest"-mode push notifications. Leave empty to
# fall back to a plain text hint ("open poledash to confirm").
PUBLIC_BASE_URL=

# --- MQTT (optional, e.g. for Home Assistant integration) -------------------
# When MQTT_HOST is set we publish state and discovery messages so HA picks the
# car up automatically as a device with sensors.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=poledash
MQTT_HA_DISCOVERY=true
