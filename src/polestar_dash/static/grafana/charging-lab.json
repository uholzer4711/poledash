{
  "annotations": {
    "list": [
      {"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard"},
      {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "enable": true, "iconColor": "#ff5b14", "name": "Session start", "expr": "(poledash_charging == 1) unless (poledash_charging offset 3m == 1)", "step": "60s", "titleFormat": "Session start"},
      {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "enable": true, "iconColor": "rgba(155, 214, 107, 0.9)", "name": "Session end", "expr": "(poledash_charging == 0) unless (poledash_charging offset 3m == 0)", "step": "60s", "titleFormat": "Session end"}
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "type": "text",
      "id": 100,
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "transparent": true,
      "options": {"mode": "html", "content": "<div style=\"font-family:'JetBrains Mono',monospace;color:#b8babf;letter-spacing:.2em;font-size:11px;text-transform:uppercase\">poledash · charging lab</div><div style=\"font-family:'Inter Tight',Inter,sans-serif;color:#f3f4f6;font-size:34px;font-weight:600\">Charging <span style=\"color:#ff5b14\">forensics</span></div><div style=\"font-family:'JetBrains Mono',monospace;color:#8a8d93;font-size:11px\">Power curves, voltage/current waveforms, taper behavior, AC↔DC split.</div>"}
    },
    {
      "type": "stat", "title": "Power", "id": 1,
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w / 1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "kwatt", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#ff5b14"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value"}
    },
    {
      "type": "stat", "title": "Voltage", "id": 2,
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_voltage_v", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "volt", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#9bd66b"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value"}
    },
    {
      "type": "stat", "title": "Current", "id": 3,
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_current_a", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "amp", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#6db5ff"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value"}
    },
    {
      "type": "stat", "title": "P = U·I (sanity)", "id": 4,
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(poledash_charging_voltage_v * poledash_charging_current_a) / 1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "kwatt", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#b8babf"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value"}
    },
    {
      "type": "stat", "title": "Charging type", "id": 5,
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_charging_dc * 2 + poledash_charging_ac", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "—", "color": "gray"}, "1": {"text": "AC", "color": "#9bd66b"}, "2": {"text": "DC", "color": "#ff5b14"}}}], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "gray", "value": null}]}}},
      "options": {"graphMode": "none", "colorMode": "background", "textMode": "value", "justifyMode": "center"}
    },
    {
      "type": "stat", "title": "Time to full", "id": 6,
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_minutes_to_full", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "m", "color": {"mode": "fixed", "fixedColor": "#ff5b14"}}},
      "options": {"graphMode": "none", "colorMode": "value", "textMode": "value"}
    },

    {
      "type": "xychart", "title": "Charging curve · power vs SoC", "id": 10,
      "gridPos": {"h": 11, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_soc_percent", "refId": "A", "format": "time_series"},
        {"expr": "poledash_charging_power_w/1000", "refId": "B", "format": "time_series"}
      ],
      "options": {"mapping": "manual", "series": [{"frame": {"matcher": {"id": "byRefId", "options": "A"}}, "name": "P vs SoC", "pointSize": {"fixed": 6}, "pointColor": {"fixed": "#ff5b14"}}], "legend": {"showLegend": false}},
      "fieldConfig": {"defaults": {"custom": {"show": "points", "pointSize": 5, "pointColor": "#ff5b14"}}}
    },
    {
      "type": "heatmap", "title": "Power density over time", "id": 11,
      "gridPos": {"h": 11, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w / 1000", "refId": "A"}],
      "options": {"calculate": true, "calculation": {"xBuckets": {"mode": "size", "value": "1h"}, "yBuckets": {"mode": "count", "value": "30"}}, "yAxis": {"axisPlacement": "left", "unit": "kwatt", "decimals": 1, "min": "0"}, "color": {"mode": "scheme", "scheme": "Oranges", "steps": 64, "exponent": 0.5}, "cellGap": 1, "filterValues": {"le": 0.001}, "tooltip": {"show": true}, "legend": {"show": true}},
      "fieldConfig": {"defaults": {"custom": {"scaleDistribution": {"type": "linear"}}}}
    },

    {
      "type": "timeseries", "title": "Voltage (V)", "id": 20,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_voltage_v", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "volt", "color": {"mode": "fixed", "fixedColor": "#9bd66b"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "spanNulls": true, "gradientMode": "opacity"}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries", "title": "Current (A)", "id": 21,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_current_a", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "amp", "color": {"mode": "fixed", "fixedColor": "#6db5ff"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "spanNulls": true, "gradientMode": "opacity"}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries", "title": "Power (kW)", "id": 22,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w / 1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "kwatt", "color": {"mode": "fixed", "fixedColor": "#ff5b14"}, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 30, "spanNulls": true, "gradientMode": "opacity"}}},
      "options": {"legend": {"showLegend": false}}
    },

    {
      "type": "state-timeline", "title": "AC ▌ DC ▌ idle", "id": 30,
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 26},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_charging_ac + poledash_charging_dc*2", "legendFormat": "mode", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "idle", "color": "#2a2c30"}, "1": {"text": "AC", "color": "#9bd66b"}, "2": {"text": "DC", "color": "#ff5b14"}}}], "color": {"mode": "thresholds"}, "custom": {"lineWidth": 0, "fillOpacity": 90}}},
      "options": {"showValue": "auto", "rowHeight": 0.9, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false}}
    },

    {
      "type": "timeseries", "title": "Minutes to full · prediction trajectory", "id": 31,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_minutes_to_full", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "m", "color": {"mode": "fixed", "fixedColor": "#ff5b14"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 18, "spanNulls": true, "gradientMode": "opacity"}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries", "title": "SoC delta (Δ per 5min, %)", "id": 32,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(poledash_soc_percent - poledash_soc_percent offset 5m)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "fixed", "fixedColor": "#9bd66b"}, "custom": {"drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "spanNulls": false, "barAlignment": 0}}},
      "options": {"legend": {"showLegend": false}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["polestar", "poledash", "charging", "lab"],
  "templating": {"list": []},
  "time": {"from": "now-7d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Polestar · Charging Lab",
  "uid": "poledash-charging-lab",
  "version": 1,
  "weekStart": "",
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0"}, {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}, {"type": "panel", "id": "stat", "name": "Stat", "version": ""}, {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}, {"type": "panel", "id": "heatmap", "name": "Heatmap", "version": ""}, {"type": "panel", "id": "state-timeline", "name": "State timeline", "version": ""}, {"type": "panel", "id": "xychart", "name": "XY Chart", "version": ""}, {"type": "panel", "id": "text", "name": "Text", "version": ""}]
}
