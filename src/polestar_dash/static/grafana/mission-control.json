{
  "annotations": {
    "list": [
      {"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard"},
      {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "enable": true, "iconColor": "#ff5b14", "name": "▲ start", "expr": "(poledash_charging == 1) unless (poledash_charging offset 2m == 1)", "step": "60s", "titleFormat": "session.start"},
      {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "enable": true, "iconColor": "#6db5ff", "name": "▼ end", "expr": "(poledash_charging == 0) unless (poledash_charging offset 2m == 0)", "step": "60s", "titleFormat": "session.end"}
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "type": "text", "id": 100, "transparent": true,
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "html", "content": "<div style=\"font-family:'JetBrains Mono',monospace;color:#ff5b14;letter-spacing:.3em;font-size:11px;text-transform:uppercase\">⚡ poledash · mission control</div><div style=\"font-family:'Inter Tight',Inter,sans-serif;color:#f3f4f6;font-size:36px;font-weight:600;letter-spacing:-.01em\">VEHICLE <span style=\"color:#ff5b14\">TELEMETRY</span> // LIVE</div><div style=\"font-family:'JetBrains Mono',monospace;color:#8a8d93;font-size:10px;letter-spacing:.15em\">DENSE GRID · 24 PANELS · 10s REFRESH</div>"}
    },

    {"type": "stat", "title": "SOC", "id": 1, "gridPos": {"h": 4, "w": 3, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_soc_percent", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 0, "color": {"mode": "continuous-GrYlRd"}, "min": 0, "max": 100}}, "options": {"graphMode": "area", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "POWER", "id": 2, "gridPos": {"h": 4, "w": 3, "x": 3, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_charging_power_w/1000", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "kwatt", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#ff5b14"}}}, "options": {"graphMode": "area", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "VOLT", "id": 3, "gridPos": {"h": 4, "w": 3, "x": 6, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_charging_voltage_v", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "volt", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#9bd66b"}}}, "options": {"graphMode": "area", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "AMPS", "id": 4, "gridPos": {"h": 4, "w": 3, "x": 9, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_charging_current_a", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "amp", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#6db5ff"}}}, "options": {"graphMode": "area", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "RANGE", "id": 5, "gridPos": {"h": 4, "w": 3, "x": 12, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_range_km", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "lengthkm", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#f3f4f6"}}}, "options": {"graphMode": "area", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "TTF", "id": 6, "gridPos": {"h": 4, "w": 3, "x": 15, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_minutes_to_full", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "m", "color": {"mode": "fixed", "fixedColor": "#ff5b14"}}}, "options": {"graphMode": "area", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "TARGET", "id": 7, "gridPos": {"h": 4, "w": 3, "x": 18, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_target_soc_percent", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#ffd166"}}}, "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},
    {"type": "stat", "title": "ODO", "id": 8, "gridPos": {"h": 4, "w": 3, "x": 21, "y": 3}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "poledash_odometer_km", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "lengthkm", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#b8babf"}}}, "options": {"graphMode": "none", "colorMode": "value", "textMode": "value", "justifyMode": "center"}},

    {
      "type": "state-timeline", "title": "STATUS", "id": 10,
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_charging_ac + poledash_charging_dc*2", "legendFormat": "mode", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "IDLE", "color": "#1f2126"}, "1": {"text": "AC", "color": "#9bd66b"}, "2": {"text": "DC", "color": "#ff5b14"}}}], "color": {"mode": "thresholds"}, "custom": {"lineWidth": 0, "fillOpacity": 95}}},
      "options": {"showValue": "auto", "rowHeight": 0.92, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false}}
    },

    {
      "type": "timeseries", "title": "soc%", "id": 20,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_soc_percent", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "#ff5b14"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 22, "gradientMode": "opacity", "spanNulls": true}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries", "title": "power.kw", "id": 21,
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 10},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w/1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "kwatt", "color": {"mode": "fixed", "fixedColor": "#ff5b14"}, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 30, "spanNulls": true, "gradientMode": "opacity"}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries", "title": "range.km", "id": 22,
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 10},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_range_km", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "lengthkm", "color": {"mode": "fixed", "fixedColor": "#f3f4f6"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true, "gradientMode": "opacity"}}},
      "options": {"legend": {"showLegend": false}}
    },

    {
      "type": "bargauge", "title": "SOC ⟶ TARGET", "id": 30,
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_soc_percent", "legendFormat": "now", "refId": "A"},
        {"expr": "poledash_target_soc_percent", "legendFormat": "tgt", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "#3a3d44", "value": null}, {"color": "#ff5b14", "value": 1}]}}},
      "options": {"orientation": "horizontal", "displayMode": "lcd", "showUnfilled": true, "valueMode": "color"}
    },
    {
      "type": "gauge", "title": "P (kW)", "id": 31,
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w/1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "kwatt", "decimals": 1, "min": 0, "max": 250, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "#3a3d44", "value": null}, {"color": "#ff5b14", "value": 1}]}}},
      "options": {"showThresholdMarkers": false, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "gauge", "title": "I (A)", "id": 32,
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_current_a", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "amp", "min": 0, "max": 200, "color": {"mode": "fixed", "fixedColor": "#6db5ff"}}},
      "options": {"showThresholdMarkers": false, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "gauge", "title": "U (V)", "id": 33,
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_voltage_v", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "volt", "min": 0, "max": 500, "color": {"mode": "fixed", "fixedColor": "#9bd66b"}}},
      "options": {"showThresholdMarkers": false, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },

    {
      "type": "heatmap", "title": "power.density", "id": 40,
      "gridPos": {"h": 10, "w": 14, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w/1000", "refId": "A"}],
      "options": {"calculate": true, "calculation": {"xBuckets": {"mode": "size", "value": "30m"}, "yBuckets": {"mode": "count", "value": "24"}}, "yAxis": {"axisPlacement": "left", "unit": "kwatt", "decimals": 1, "min": "0"}, "color": {"mode": "scheme", "scheme": "Oranges", "steps": 64, "exponent": 0.6}, "cellGap": 1, "filterValues": {"le": 0.001}, "tooltip": {"show": true}, "legend": {"show": true}}
    },
    {
      "type": "xychart", "title": "P × SOC", "id": 41,
      "gridPos": {"h": 10, "w": 10, "x": 14, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_soc_percent", "refId": "A", "format": "time_series"},
        {"expr": "poledash_charging_power_w/1000", "refId": "B", "format": "time_series"}
      ],
      "options": {"mapping": "manual", "series": [{"frame": {"matcher": {"id": "byRefId", "options": "A"}}, "name": "scatter", "pointSize": {"fixed": 5}, "pointColor": {"fixed": "#ff5b14"}}], "legend": {"showLegend": false}},
      "fieldConfig": {"defaults": {"custom": {"show": "points", "pointSize": 4, "pointColor": "#ff5b14"}}}
    },

    {
      "type": "stat", "title": "DC.share", "id": 50,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 30},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "avg_over_time(poledash_charging_dc[7d])*100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#ff5b14"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value_and_name"}
    },
    {
      "type": "stat", "title": "AC.share", "id": 51,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 30},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "avg_over_time(poledash_charging_ac[7d])*100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#9bd66b"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value_and_name"}
    },
    {
      "type": "stat", "title": "service.days", "id": 52,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 30},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_days_to_service", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "d", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 30}, {"color": "green", "value": 180}]}}},
      "options": {"graphMode": "none", "colorMode": "background", "textMode": "value_and_name"}
    },
    {
      "type": "stat", "title": "service.km", "id": 53,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 30},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_distance_to_service_km", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "lengthkm", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1000}, {"color": "green", "value": 5000}]}}},
      "options": {"graphMode": "none", "colorMode": "background", "textMode": "value_and_name"}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["polestar", "poledash", "ops"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Polestar · Mission Control",
  "uid": "poledash-mission-control",
  "version": 1,
  "weekStart": "",
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0"}, {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}, {"type": "panel", "id": "stat", "name": "Stat", "version": ""}, {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}, {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""}, {"type": "panel", "id": "bargauge", "name": "Bar gauge", "version": ""}, {"type": "panel", "id": "heatmap", "name": "Heatmap", "version": ""}, {"type": "panel", "id": "state-timeline", "name": "State timeline", "version": ""}, {"type": "panel", "id": "xychart", "name": "XY Chart", "version": ""}, {"type": "panel", "id": "text", "name": "Text", "version": ""}]
