{
  "annotations": {
    "list": [
      {"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard"}
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "type": "text", "id": 100, "transparent": true,
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "html", "content": "<div style=\"font-family:'JetBrains Mono',monospace;color:#b8babf;letter-spacing:.2em;font-size:11px;text-transform:uppercase\">poledash · fleet pulse</div><div style=\"font-family:'Inter Tight',Inter,sans-serif;color:#f3f4f6;font-size:34px;font-weight:600\">Daily <span style=\"color:#ff5b14\">rhythm</span></div><div style=\"font-family:'JetBrains Mono',monospace;color:#8a8d93;font-size:11px\">When charging happens, how SoC breathes through the week, polling cadence.</div>"}
    },

    {
      "type": "state-timeline", "title": "Charging timeline · 30d", "id": 1,
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 3},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "idle", "color": "#1f2126"}, "1": {"text": "charging", "color": "#ff5b14"}}}], "color": {"mode": "thresholds"}, "custom": {"lineWidth": 0, "fillOpacity": 95}}},
      "options": {"showValue": "never", "rowHeight": 0.92, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false}}
    },

    {
      "type": "heatmap", "title": "Charging activity · hour of day", "id": 2,
      "gridPos": {"h": 11, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging * 100", "refId": "A"}],
      "options": {"calculate": true, "calculation": {"xBuckets": {"mode": "size", "value": "24h"}, "yBuckets": {"mode": "size", "value": "1h"}}, "yAxis": {"axisPlacement": "left", "decimals": 0}, "color": {"mode": "scheme", "scheme": "Oranges", "steps": 64, "exponent": 0.5}, "cellGap": 2, "filterValues": {"le": 0.001}, "tooltip": {"show": true}, "legend": {"show": true}},
      "fieldConfig": {"defaults": {"custom": {"scaleDistribution": {"type": "linear"}}}}
    },
    {
      "type": "heatmap", "title": "SoC heatmap · hour of day", "id": 3,
      "gridPos": {"h": 11, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_soc_percent", "refId": "A"}],
      "options": {"calculate": true, "calculation": {"xBuckets": {"mode": "size", "value": "24h"}, "yBuckets": {"mode": "count", "value": "20"}}, "yAxis": {"axisPlacement": "left", "unit": "percent", "decimals": 0, "min": "0", "max": "100"}, "color": {"mode": "scheme", "scheme": "Viridis", "steps": 64}, "cellGap": 2, "filterValues": {"le": 0.001}, "tooltip": {"show": true}, "legend": {"show": true}}
    },

    {
      "type": "timeseries", "title": "SoC band · weekly breathing", "id": 4,
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "max_over_time(poledash_soc_percent[6h])", "legendFormat": "max", "refId": "A"},
        {"expr": "min_over_time(poledash_soc_percent[6h])", "legendFormat": "min", "refId": "B"},
        {"expr": "avg_over_time(poledash_soc_percent[6h])", "legendFormat": "avg", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "max"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#ff5b14"}}, {"id": "custom.fillBelowTo", "value": "min"}, {"id": "custom.fillOpacity", "value": 18}]},
          {"matcher": {"id": "byName", "options": "min"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#ff5b14"}}]},
          {"matcher": {"id": "byName", "options": "avg"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#f3f4f6"}}, {"id": "custom.lineWidth", "value": 3}]}
        ]
      },
      "options": {"legend": {"showLegend": true, "placement": "bottom", "displayMode": "list"}}
    },
    {
      "type": "stat", "title": "Sessions started · 7d", "id": 5,
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(changes(poledash_charging[7d]) / 2)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#ff5b14"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value_and_name", "justifyMode": "center"}
    },
    {
      "type": "stat", "title": "Charging · share of last 24h", "id": 6,
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "avg_over_time(poledash_charging[24h]) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "color": {"mode": "fixed", "fixedColor": "#9bd66b"}}},
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value_and_name", "justifyMode": "center"}
    },

    {
      "type": "bargauge", "title": "Δ SoC per 24h", "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(poledash_soc_percent - poledash_soc_percent offset 24h)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": -100, "max": 100, "color": {"mode": "continuous-GrYlRd"}}},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "valueMode": "color"}
    },
    {
      "type": "timeseries", "title": "Polling cadence · samples / 5m", "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "count_over_time(poledash_soc_percent[5m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#6db5ff"}, "custom": {"drawStyle": "bars", "lineWidth": 0, "fillOpacity": 75, "barAlignment": 0}}},
      "options": {"legend": {"showLegend": false}}
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["polestar", "poledash", "rhythm"],
  "templating": {"list": []},
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Polestar · Fleet Pulse",
  "uid": "poledash-fleet-pulse",
  "version": 1,
  "weekStart": "",
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0"}, {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}, {"type": "panel", "id": "stat", "name": "Stat", "version": ""}, {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}, {"type": "panel", "id": "heatmap", "name": "Heatmap", "version": ""}, {"type": "panel", "id": "state-timeline", "name": "State timeline", "version": ""}, {"type": "panel", "id": "bargauge", "name": "Bar gauge", "version": ""}, {"type": "panel", "id": "text", "name": "Text", "version": ""}]
}
