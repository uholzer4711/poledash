{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "enable": true,
        "iconColor": "#ff5b14",
        "name": "Charge start",
        "expr": "(poledash_charging == 1) unless (poledash_charging offset 2m == 1)",
        "step": "60s",
        "titleFormat": "Charging started",
        "textFormat": "VIN {{vin}}",
        "useValueForTime": false
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "enable": true,
        "iconColor": "rgba(140, 140, 140, 0.9)",
        "name": "Charge stop",
        "expr": "(poledash_charging == 0) unless (poledash_charging offset 2m == 0)",
        "step": "60s",
        "titleFormat": "Charging stopped",
        "textFormat": "VIN {{vin}}",
        "useValueForTime": false
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "poledash dashboard", "url": "/", "type": "link", "icon": "external link", "targetBlank": true}
  ],
  "liveNow": true,
  "panels": [
    {
      "type": "gauge",
      "title": "State of charge",
      "id": 1,
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_soc_percent", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 20},
              {"color": "yellow", "value": 40},
              {"color": "green", "value": 60}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "gauge",
      "title": "Power",
      "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w / 1000", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "min": 0, "max": 250,
          "color": {"mode": "fixed", "fixedColor": "#ff5b14"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "gray", "value": null},
              {"color": "#ff5b14", "value": 0.1}
            ]
          }
        }
      },
      "options": {"showThresholdMarkers": false, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "gauge",
      "title": "Voltage",
      "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_voltage_v", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "min": 0, "max": 500,
          "color": {"mode": "fixed", "fixedColor": "#b8babf"}
        }
      },
      "options": {"showThresholdMarkers": false, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "gauge",
      "title": "Current",
      "id": 4,
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_current_a", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0, "max": 200,
          "color": {"mode": "fixed", "fixedColor": "#b8babf"}
        }
      },
      "options": {"showThresholdMarkers": false, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },

    {
      "type": "state-timeline",
      "title": "Charging timeline",
      "id": 5,
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "idle",     "color": "#2a2c30", "index": 0}}},
            {"type": "value", "options": {"1": {"text": "charging", "color": "#ff5b14", "index": 1}}}
          ],
          "color": {"mode": "thresholds"},
          "custom": {"lineWidth": 0, "fillOpacity": 90}
        }
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {"showLegend": false}
      }
    },

    {
      "type": "timeseries",
      "title": "SoC %",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_soc_percent", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "pointSize": 0, "spanNulls": true}
        }
      },
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries",
      "title": "Charging power (kW)",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w / 1000", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {"mode": "fixed", "fixedColor": "#ff5b14"},
          "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 25, "pointSize": 0, "spanNulls": true}
        }
      },
      "options": {"legend": {"showLegend": false}}
    },

    {
      "type": "timeseries",
      "title": "Range (km)",
      "id": 8,
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_range_km", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "lengthkm", "custom": {"lineWidth": 2, "fillOpacity": 8, "pointSize": 0, "spanNulls": true}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries",
      "title": "Consumption (kWh/100km)",
      "id": 9,
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_avg_consumption_kwh_per_100km", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 1, "custom": {"lineWidth": 2, "fillOpacity": 8, "pointSize": 0, "spanNulls": true}}},
      "options": {"legend": {"showLegend": false}}
    },
    {
      "type": "timeseries",
      "title": "Odometer (km)",
      "id": 10,
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_odometer_km", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "lengthkm", "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 0, "pointSize": 0, "spanNulls": true}}},
      "options": {"legend": {"showLegend": false}}
    },

    {
      "type": "heatmap",
      "title": "Charging power distribution over time",
      "id": 11,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 27},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_charging_power_w / 1000", "legendFormat": "kW", "refId": "A"}],
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": {"mode": "size", "value": "1h"},
          "yBuckets": {"mode": "count", "value": "20"}
        },
        "yAxis": {"axisPlacement": "left", "unit": "kwatt", "decimals": 1, "min": "0"},
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5
        },
        "cellGap": 1,
        "filterValues": {"le": 0.001},
        "tooltip": {"show": true, "yHistogram": false},
        "legend": {"show": true},
        "exemplars": {"color": "rgba(255,0,255,0.7)"}
      },
      "fieldConfig": {"defaults": {"custom": {"scaleDistribution": {"type": "linear"}}}}
    },
    {
      "type": "xychart",
      "title": "Charging curve · power vs SoC",
      "id": 12,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 27},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_soc_percent",          "legendFormat": "soc",   "refId": "A", "format": "time_series"},
        {"expr": "poledash_charging_power_w/1000", "legendFormat": "power", "refId": "B", "format": "time_series"}
      ],
      "options": {
        "mapping": "manual",
        "series": [
          {
            "frame": {"matcher": {"id": "byRefId", "options": "A"}},
            "x": {"matcher": {"id": "byName", "options": "Value"}},
            "y": {"matcher": {"id": "byName", "options": "Value"}, "field": "B"},
            "name": "Power vs SoC",
            "pointSize": {"fixed": 5},
            "pointColor": {"fixed": "#ff5b14"}
          }
        ],
        "legend": {"showLegend": false}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "show": "points",
            "pointSize": 4,
            "pointColor": "#ff5b14",
            "axisPlacement": "auto"
          }
        }
      }
    },

    {
      "type": "timeseries",
      "title": "Current (A) · Voltage (V)",
      "id": 13,
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 36},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_charging_current_a", "legendFormat": "A · {{vin}}", "refId": "A"},
        {"expr": "poledash_charging_voltage_v", "legendFormat": "V · {{vin}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1.5, "fillOpacity": 0, "pointSize": 0, "spanNulls": true}}}
    },
    {
      "type": "stat",
      "title": "Minutes to full",
      "id": 14,
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 36},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "poledash_minutes_to_full", "legendFormat": "{{vin}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "color": {"mode": "fixed", "fixedColor": "#ff5b14"}
        }
      },
      "options": {"graphMode": "area", "colorMode": "value", "textMode": "value"}
    },
    {
      "type": "stat",
      "title": "Service due",
      "id": 15,
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 36},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "poledash_days_to_service",        "legendFormat": "days · {{vin}}", "refId": "A"},
        {"expr": "poledash_distance_to_service_km", "legendFormat": "km · {{vin}}",   "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red",    "value": null},
            {"color": "orange", "value": 30},
            {"color": "green",  "value": 180}
          ]},
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"colorMode": "value", "textMode": "value_and_name", "graphMode": "none"}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["polestar", "poledash", "ev"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Polestar · poledash",
  "uid": "poledash-main",
  "version": 2,
  "weekStart": "",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source that scrapes poledash /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "state-timeline", "name": "State timeline", "version": ""},
    {"type": "panel", "id": "heatmap", "name": "Heatmap", "version": ""},
    {"type": "panel", "id": "xychart", "name": "XY Chart", "version": ""}
  ]
}
